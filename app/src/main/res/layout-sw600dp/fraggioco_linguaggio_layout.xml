<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".FragQuiz"
    android:background="@color/cardview_shadow_start_color">

    <TextView
        android:id="@+id/punteggio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="19dp"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_questionario"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.80"
        app:layout_constraintHeight_percent="0.75"
        app:cardCornerRadius="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/frase"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:padding="10dp"
                app:layout_constraintHeight_percent="0.08"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <TextView
                android:id="@+id/frasetradotta"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:padding="10dp"
                app:layout_constraintHeight_percent="0.20"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:layout_marginBottom="10dp"
                app:layout_constraintTop_toBottomOf="@id/frase"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <Button
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="1"
                android:textColor="@color/white"
                android:backgroundTint="#0D69E5"
                app:layout_constraintWidth_percent="0.90"
                app:layout_constraintHeight_percent="0.13"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/frase"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="2"
                android:textColor="@color/white"
                android:backgroundTint="#0D69E5"
                app:layout_constraintWidth_percent="0.90"
                app:layout_constraintHeight_percent="0.13"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/btn1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="3"
                android:textColor="@color/white"
                android:backgroundTint="#0D69E5"
                app:layout_constraintWidth_percent="0.90"
                app:layout_constraintHeight_percent="0.13"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/btn2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <Button
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#0D69E5"
                android:text="4"
                android:textColor="@color/white"
                app:layout_constraintWidth_percent="0.90"
                app:layout_constraintHeight_percent="0.13"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/btn3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
            <Button
                android:id="@+id/btnnext"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#0D69E5"
                android:text="PROSSIMA"
                android:textColor="@color/white"
                android:alpha="0"
                app:layout_constraintWidth_percent="0.60"
                app:layout_constraintHeight_percent="0.08"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toBottomOf="@id/btn4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>


    <ImageView
        android:id="@+id/icona_home"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.40"
        app:layout_constraintHeight_percent="0.10"
        android:src="@drawable/immagine_home"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>