<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:background="@drawable/fotospazio"
    android:layout_width="match_parent">

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        app:layout_constraintWidth_percent="0.90"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.80"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardElevation="8dp"
        app:cardCornerRadius="40dp"
        android:backgroundTint="#46A2B8"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >
            <ImageView
                android:id="@+id/x_rossa"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:elevation="10dp"
                android:layout_marginBottom="10dp"
                app:layout_constraintStart_toStartOf="@id/card_img_utente"
                app:layout_constraintTop_toTopOf="@id/card_img_utente"
                android:src="@drawable/icona_x_rossa"
                />
            <androidx.cardview.widget.CardView
                android:id="@+id/card_img_utente"
                android:layout_width="0dp"
                app:layout_constraintWidth_percent="0.75"
                android:layout_height="0dp"
                app:layout_constraintHeight_percent="0.40"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:cardCornerRadius="60dp"
                android:layout_marginTop="10dp"
                app:cardElevation="2dp">
                <ImageView
                    android:id="@+id/img_utente"
                    android:layout_width="match_parent"
                    android:scaleType="centerCrop"
                    android:layout_height="match_parent"
                    tools:src="@drawable/icona_utente"
                    />
            </androidx.cardview.widget.CardView>

            <EditText
                android:id="@+id/txt_utente"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:inputType="textCapSentences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@+id/card_img_utente"
                android:text="Nome Utente"
                android:textSize="25sp"
                android:textStyle="bold"
                />

            <Button
            android:id="@+id/btninvia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#52C549"
            android:text="MODIFICA"
            android:textColor="@color/white"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.75"
            app:layout_constraintBottom_toTopOf="@id/btnindietro"
             />
            <Button
                android:id="@+id/btnindietro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:backgroundTint="#D33F3F"
                android:text="INDIETRO"
                android:textColor="@color/white"
                android:textSize="30sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btninvia"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.75"
                 />
<TextView
    android:id="@+id/txt_quiz"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Quiz Svolti:"
    android:textSize="25sp"
    android:textColor="@color/white"
    android:textStyle="bold"
  android:layout_marginTop="10dp"
   app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/txt_utente"

    />
            <TextView
                android:id="@+id/txt_punteggio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Punteggio Totale:"
                android:textSize="25sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txt_quiz"
                app:layout_constraintBottom_toTopOf="@id/txt_percentuale"
                />
            <TextView
                android:id="@+id/txt_percentuale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                android:text="Percentuale Quiz Corretti:"
                android:textSize="25sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txt_quiz"
                app:layout_constraintBottom_toTopOf="@id/btninvia"

                />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>