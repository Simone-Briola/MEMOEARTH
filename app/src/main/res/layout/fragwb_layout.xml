<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="#276BA3"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:alpha="0.8"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_tendina"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/icona_home"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="25dp"
                android:src="@drawable/immagine_home"
                app:layout_constraintHeight_percent="0.78"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.40" />


            <ImageView
                android:id="@+id/icona_ricordo"
                android:layout_width="173dp"
                android:layout_height="92dp"
                android:layout_marginTop="25dp"
                android:alpha="0.4"
                android:src="@drawable/bottone_aggiungi_ricordo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.78"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.40" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <WebView
        android:id="@+id/Wbmondo"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btntendina"
        android:text="Menu"
        android:textColor="@color/white"
        android:layout_width="120dp"
        android:layout_height="35dp"
        android:backgroundTint="@color/teal_700"
        android:clickable="true"
        android:focusable="true"
        android:elevation="15dp"
        android:layout_marginTop="20dp"
        android:translationZ="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>